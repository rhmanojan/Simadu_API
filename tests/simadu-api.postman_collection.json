{
  "info": {
    "name": "SIMADU API — UTS Web Service Engineering",
    "description": "Koleksi pengujian Postman untuk 12 skenario wajib dan skenario keamanan tambahan SIMADU API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "mhs1Token", "value": "" },
    { "key": "adminToken", "value": "" }
  ],
  "item": [
    {
      "name": "01. Login dengan kredensial benar (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 dan token diterima', () => {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.token).to.be.a('string');",
              "  pm.collectionVariables.set('mhs1Token', json.data.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"mhs01\",\n  \"password\": \"Mhs12345!\"\n}" },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "01b. Login Admin (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Admin login 200', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.collectionVariables.set('adminToken', pm.response.json().data.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin01\",\n  \"password\": \"Admin12345!\"\n}" },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "02. Login dengan password salah (401)",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));"] } }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"mhs01\",\n  \"password\": \"SalahPassword!\"\n}" },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "03. Akses endpoint terlindungi tanpa token (401)",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));"] } }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/pengaduan"
      }
    },
    {
      "name": "04. Akses menggunakan token tidak valid (401)",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));"] } }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer token.tidak.valid" }],
        "url": "{{baseUrl}}/api/pengaduan"
      }
    },
    {
      "name": "05. Mahasiswa membuat pengaduan valid (201)",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));"] } }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{mhs1Token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"judul\": \"AC Ruang Kuliah R-301 Tidak Dingin\",\n  \"kategori\": \"Fasilitas\",\n  \"deskripsi\": \"AC di ruang kuliah R-301 mati sejak kemarin siang sehingga perkuliahan tidak nyaman.\"\n}"
        },
        "url": "{{baseUrl}}/api/pengaduan"
      }
    },
    {
      "name": "06. Mahasiswa membaca pengaduan sendiri (200)",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{mhs1Token}}" }],
        "url": "{{baseUrl}}/api/pengaduan/1"
      }
    },
    {
      "name": "07. Mahasiswa mencoba membaca pengaduan orang lain (403)",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status 403', () => pm.response.to.have.status(403));"] } }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{mhs1Token}}" }],
        "url": "{{baseUrl}}/api/pengaduan/3"
      }
    },
    {
      "name": "08. Mahasiswa mengubah status pengaduan (403)",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status 403', () => pm.response.to.have.status(403));"] } }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{mhs1Token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"selesai\"\n}" },
        "url": "{{baseUrl}}/api/pengaduan/1/status"
      }
    },
    {
      "name": "09. Admin melihat seluruh pengaduan (200)",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/api/pengaduan"
      }
    },
    {
      "name": "10. Admin memperbarui status pengaduan (200)",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"diproses\"\n}" },
        "url": "{{baseUrl}}/api/pengaduan/1/status"
      }
    },
    {
      "name": "11. Membuat pengaduan dengan field wajib kosong (400)",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"] } }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{mhs1Token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"judul\": \"\",\n  \"kategori\": \"Fasilitas\",\n  \"deskripsi\": \"\"\n}" },
        "url": "{{baseUrl}}/api/pengaduan"
      }
    },
    {
      "name": "12. Mengakses ID pengaduan yang tidak ditemukan (404)",
      "event": [
        { "listen": "test", "script": { "exec": ["pm.test('Status 404', () => pm.response.to.have.status(404));"] } }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/api/pengaduan/999"
      }
    }
  ]
}
