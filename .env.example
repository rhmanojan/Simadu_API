# Konfigurasi Server SIMADU API
PORT=3000
NODE_ENV=development

# Konfigurasi Keamanan JWT Bearer Token
# Ganti nilai JWT_SECRET dengan string acak panjang yang aman pada lingkungan produksi
JWT_SECRET=simadu_uts_wse_2026_super_secret_key_change_in_production
JWT_EXPIRES_IN=1h

# Konfigurasi Opsional API Key (Pengembangan Tambahan)
# Set REQUIRE_API_KEY=true untuk mewajibkan header x-api-key selain Bearer Token
REQUIRE_API_KEY=false
API_KEY=simadu-client-api-key-2026
